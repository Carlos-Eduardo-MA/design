# Gere um segredo novo para cada ambiente:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Use um e-mail e uma senha exclusivos; a senha deve ter pelo menos 16 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Use um usuário MySQL dedicado, com acesso somente ao banco da aplicação.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
DB_NAME=

# Origens completas, sem barra no final. Não use "*".
CORS_ORIGINS=https://carlos-eduardo-ma.github.io,http://localhost:3000,http://127.0.0.1:3000
